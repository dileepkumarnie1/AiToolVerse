// Cloudflare Workers static hosting. The build output in dist/ is served as-is;
// public/_headers and public/_redirects are applied by Cloudflare.
{
  "name": "aitoolverse",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
