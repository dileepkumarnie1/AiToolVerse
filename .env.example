# Public Firebase web config for the NEW project (safe to ship ONLY if the API key is
# restricted to aitoolverse.ai + Identity Toolkit, Token Service, Firestore, App Check).
# Leave empty to run without sign-in (profiles are then saved in the browser only).
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
# Site key for Firebase App Check (Google Cloud Fraud Defense, formerly reCAPTCHA Enterprise; score-based website key).
PUBLIC_RECAPTCHA_SITE_KEY=

# Newsletter sign-up (optional). The form posts to your email provider's subscribe address.
# Leave empty to hide the form; visitors are then offered the RSS feed.
PUBLIC_NEWSLETTER_ACTION=
# Name of the email field your provider expects (often "email").
PUBLIC_NEWSLETTER_FIELD=email
# Provider name shown in the privacy policy, e.g. "Buttondown".
PUBLIC_NEWSLETTER_PROVIDER=

# Never put API secrets here. The build fails on names containing SECRET, TOKEN, GEMINI, OPENAI, etc.
