---
import Base from '../../layouts/Base.astro';
import ToolTile from '../../components/ToolTile';
import PipelineTile from '../../components/PipelineTile';
import { capabilities, categoryById, pipelinesForCapability, toolsWithCapability, toPipelineIndexEntry } from '../../lib/catalog';
import type { Capability } from '../../lib/types';

export function getStaticPaths() {
  return capabilities.filter((c) => toolsWithCapability(c.id).length > 0).map((capability) => ({ params: { capability: capability.id }, props: { capability } }));
}

const { capability } = Astro.props as { capability: Capability };
const list = toolsWithCapability(capability.id);
const top = list.slice(0, 9);
const rest = list.slice(9);
const flows = pipelinesForCapability(capability.id).map(toPipelineIndexEntry);
const category = categoryById.get(capability.category);
const year = new Date().getFullYear();
---

<Base
  title={`Best AI tools for ${capability.label.toLowerCase()} (${year})`}
  description={`Compare ${list.length} AI tools for ${capability.label.toLowerCase()}, with a quick-start guide, starter prompt and step-by-step pipelines.`}
>
  <section class="container-page pt-14">
    <nav aria-label="Breadcrumb" class="text-sm muted">
      <a href="/categories/" class="hover:text-ink-900 dark:hover:text-white">Categories</a>
      {category && <> / <a href={`/categories/${category.id}/`} class="hover:text-ink-900 dark:hover:text-white">{category.label}</a></>}
    </nav>
    <h1 class="heading-lg mt-4">Best AI tools for {capability.label.toLowerCase()}</h1>
    <p class="mt-2 max-w-2xl muted">{list.length} tools, ranked by popularity and fit for most people. <a href="/start/" class="font-semibold text-brand-700 hover:underline dark:text-brand-300">Get picks tailored to you →</a></p>

    <div class="mt-10 grid gap-8 lg:grid-cols-3">
      <div class="grid gap-4 sm:grid-cols-2 lg:col-span-2">
        {top.map((t) => <ToolTile tool={t} />)}
      </div>
      <aside class="card h-fit p-6">
        <h2 class="font-semibold text-ink-900 dark:text-white">Quick-start guide</h2>
        <ol class="mt-4 space-y-3 text-sm text-ink-700 dark:text-ink-200">
          {capability.howTo.map((s, i) => <li><span class="font-semibold text-brand-700 dark:text-brand-300">{i + 1}.</span> {s}</li>)}
        </ol>
        <p class="mt-5 text-xs font-semibold uppercase tracking-wide text-brand-700 dark:text-brand-300">Starter prompt</p>
        <p class="mt-2 rounded-lg bg-ink-100 p-3 font-mono text-xs dark:bg-white/5">{capability.samplePrompt}</p>
      </aside>
    </div>

    {
      flows.length > 0 && (
        <section class="mt-16">
          <h2 class="heading-lg">Pipelines that include {capability.label.toLowerCase()}</h2>
          <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{flows.slice(0, 6).map((p) => <PipelineTile pipeline={p} />)}</div>
        </section>
      )
    }

    {
      rest.length > 0 && (
        <section class="mt-16">
          <h2 class="text-lg font-semibold text-ink-900 dark:text-white">More {capability.label.toLowerCase()} tools</h2>
          <ul class="mt-4 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2 lg:grid-cols-3">
            {rest.map((t) => <li><a href={`/tools/${t.slug}/`} class="text-ink-700 hover:text-brand-700 dark:text-ink-200 dark:hover:text-brand-300">{t.name}</a></li>)}
          </ul>
        </section>
      )
    }
  </section>
</Base>
