---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page does not exist." noindex>
  <section class="container-page py-24 text-center">
    <p class="eyebrow">404</p>
    <h1 class="heading-lg mt-2">We couldn't find that page</h1>
    <p class="mt-2 muted">It may have moved when we rebuilt the site.</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/tools/" class="btn-primary">Browse tools</a>
      <a href="/start/" class="btn-secondary">Get my plan</a>
    </div>
  </section>
</Base>
